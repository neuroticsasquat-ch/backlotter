# Loaded into the python job's environment by the shared python.yml. Test-only values, never secrets.
# The Postgres service python.yml starts (postgres: "17" in ci.yml) is root/root on localhost:5432;
# .github/ci/setup.sh creates both databases. tests/conftest.py points the suite at
# TEST_DATABASE_URL; DATABASE_URL is what `alembic upgrade head && alembic check` migrate.
DATABASE_URL=postgresql+asyncpg://root:root@localhost:5432/upmovies
TEST_DATABASE_URL=postgresql+asyncpg://root:root@localhost:5432/upmovies_test
ADMIN_TOKEN=test-admin-token
TMDB_API_KEY=test-tmdb-key
ANTHROPIC_API_KEY=test-anthropic-key
CORS_ALLOWED_ORIGINS=https://app.upmovies.localhost
